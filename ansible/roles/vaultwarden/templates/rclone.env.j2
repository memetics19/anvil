# Managed by Ansible (role vaultwarden). Mode 600. The S3 remote "vwb" (Ceph RGW user with
# access to the backup bucket only; keys from Vault).
RCLONE_CONFIG=/dev/null
RCLONE_CONFIG_VWB_TYPE=s3
RCLONE_CONFIG_VWB_PROVIDER=Ceph
RCLONE_CONFIG_VWB_ENV_AUTH=false
RCLONE_CONFIG_VWB_ENDPOINT={{ vaultwarden_backup_endpoint }}
RCLONE_CONFIG_VWB_ACCESS_KEY_ID={{ vaultwarden_backup_keys.s3_access_key }}
RCLONE_CONFIG_VWB_SECRET_ACCESS_KEY={{ vaultwarden_backup_keys.s3_secret_key }}
