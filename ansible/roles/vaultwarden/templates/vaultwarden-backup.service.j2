# Managed by Ansible (role vaultwarden). Started by vaultwarden-backup.timer, or by hand:
#   sudo systemctl start vaultwarden-backup && journalctl -u vaultwarden-backup -n 20
[Unit]
Description=Vaultwarden backup to the Ceph S3 gateway (age-encrypted)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=vaultwarden
Group=vaultwarden
# The S3 remote "vwb" for rclone (endpoint and keys). Read by systemd as root; mode 600.
EnvironmentFile={{ vaultwarden_backup_etc }}/rclone.env
ExecStart=/usr/local/sbin/vaultwarden-backup
# The work directory (the plaintext copy and the encrypted archive) is on tmpfs, in
# /run/vaultwarden-backup (mode 700, removed by systemd when the job ends), never on disk.
# The data directory is writable because SQLite takes its WAL locks there. Everything else
# is read-only.
RuntimeDirectory=vaultwarden-backup
RuntimeDirectoryMode=0700
Environment=TMPDIR=%t/vaultwarden-backup
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths={{ vaultwarden_dir }}/data
ProtectHome=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
MemoryMax=192M
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
