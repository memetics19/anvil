# Managed by Ansible (role vaultwarden). Mode 600. The admin page token as an Argon2id PHC
# string (the token itself stays in Vault) and, when Vault holds an SMTP login, the mail
# settings. Single quotes: compose takes the values literally (no $ interpolation).
ADMIN_TOKEN='{{ vaultwarden_admin_token_hash }}'
{% if vaultwarden_smtp is defined %}
SMTP_HOST='{{ vaultwarden_smtp.host }}'
SMTP_PORT='{{ vaultwarden_smtp.port }}'
SMTP_SECURITY='{{ vaultwarden_smtp.security }}'
SMTP_FROM='{{ vaultwarden_smtp.from }}'
SMTP_FROM_NAME='{{ vaultwarden_smtp_defaults.from_name }}'
SMTP_USERNAME='{{ vaultwarden_smtp.username }}'
SMTP_PASSWORD='{{ vaultwarden_smtp.password }}'
SIGNUPS_VERIFY='true'
# Email two-step login (needs SMTP), set up automatically on every account registered from
# an invitation (names and defaults as in Vaultwarden 1.37.4's .env.template).
_ENABLE_EMAIL_2FA='true'
EMAIL_2FA_ENFORCE_ON_VERIFIED_INVITE='true'
EMAIL_EXPIRATION_TIME='{{ vaultwarden_email_2fa.expiration_seconds }}'
EMAIL_ATTEMPTS_LIMIT='{{ vaultwarden_email_2fa.attempts_limit }}'
{% endif %}
