# Managed by anvil (role netbird_server): replies of the forwarded Caddy connections go
# back to the Proxmox host through a table of their own, ahead of the NetBird clients'
# rules (netbird-reply.nft). The main table will not do: it has the NetBird interface's own
# 100.x subnet, so a reply to a peer coming through the host would skip it.
[Unit]
Description=Replies to the self-hosted NetBird server's clients through the main table
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/usr/sbin/nft -f {{ netbird_server_reply_nft }}
ExecStart=/usr/sbin/ip route replace default via {{ site.pve.gateway_alias_ip }} table {{ netbird_server_reply_table }}
ExecStart=/bin/sh -c 'while /usr/sbin/ip rule del priority {{ netbird_server_reply_rule_priority }} fwmark {{ netbird_server_reply_mark }} 2>/dev/null; do :; done; /usr/sbin/ip rule add priority {{ netbird_server_reply_rule_priority }} fwmark {{ netbird_server_reply_mark }} lookup {{ netbird_server_reply_table }}'
ExecStop=/bin/sh -c 'while /usr/sbin/ip rule del priority {{ netbird_server_reply_rule_priority }} fwmark {{ netbird_server_reply_mark }} 2>/dev/null; do :; done; /usr/sbin/ip route flush table {{ netbird_server_reply_table }}; /usr/sbin/nft delete table inet anvil_netbird_reply 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
