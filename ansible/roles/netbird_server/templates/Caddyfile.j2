{# Managed by anvil (ansible/roles/netbird_server). #}
# {{ site.netbird_domain }} from the internet: the router forwards TCP 443 to the Proxmox
# host, which forwards it here (docs/setup.md, Self-hosted NetBird). No Cloudflare in the
# path: its proxy drops gRPC trailers and cuts idle streams after 100 seconds. The routes
# are NetBird's documented Caddy example. The dashboard and the REST API are open too,
# behind NetBird's own login (the owner's password in Vault, 32 random characters).
{
	admin off
	auto_https disable_redirects
	default_sni {{ site.netbird_domain }}
	# GeoIP of each client from a local database (DB-IP City Lite), no automatic update.
	order geoip2_vars first
	geoip2 {
		databaseDirectory "/geoip"
		editionID "{{ netbird_server_geoip_edition }}"
	}
}

{{ site.netbird_domain }}:443 {
	# Let's Encrypt over TLS-ALPN on this port (no HTTP port, no DNS token on this VM).
	# While the name does not point here yet, Caddy's own CA serves instead.
	tls {
		issuer acme {
			disable_http_challenge
		}
		issuer internal
	}
	# The public name does not say what runs behind it: no Server header from Caddy or
	# the upstreams (deletions apply to proxied responses too).
	header -Server
	header -Via
	# Every request, with the client's own address (the Proxmox host's forward keeps it), in a
	# file the Wazuh agent ships (the Security dashboards' attack map). Rotated by Caddy.
	# The client's own address only (no X-Forwarded-For: clients connect directly), and its
	# country, city and coordinates in every access log line (empty for private addresses).
	geoip2_vars strict
	# srcip: Wazuh's JSON decoder takes it as the event's source address (same_srcip in the
	# scan rule, and its own GeoLocation from it in the indexer).
	log_append srcip {http.request.remote.host}
	log_append geo_country {geoip2.country_code}
	log_append geo_country_name {geoip2.country_name}
	log_append geo_city {geoip2.city_name}
	log_append geo_lat {geoip2.location_latitude}
	log_append geo_lon {geoip2.location_longitude}
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}

	# Management and signal gRPC (HTTP/2 cleartext to the server)
	@grpc header Content-Type application/grpc*
	reverse_proxy @grpc h2c://netbird-server:80
	# The relay, the browser client's WebSocket proxy, the REST API and the identity provider
	@backend path /relay* /ws-proxy/* /api/* /oauth2/*
	reverse_proxy @backend netbird-server:80
	# Everything else: the dashboard. Its own CSP lists the vendor's domains and trackers:
	# replaced with a first party one (same rules, this host only).
	reverse_proxy dashboard:80 {
		header_down Content-Security-Policy "{{ netbird_server_dashboard_csp }}"
	}
}
