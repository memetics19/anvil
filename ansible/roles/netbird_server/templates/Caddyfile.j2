{# Managed by anvil (ansible/roles/netbird_server). #}
# The Cloudflare tunnel's origin for {{ site.netbird_domain }}: one HTTPS route, HTTP/2 to
# the origin (gRPC needs it). The routes are NetBird's documented Caddy example.
{
	admin off
	auto_https disable_redirects
	default_sni {{ site.netbird_domain }}
}

{{ site.netbird_domain }}:443 {
	tls internal
	# Management and signal gRPC (HTTP/2 cleartext to the server)
	@grpc header Content-Type application/grpc*
	reverse_proxy @grpc h2c://netbird-server:80
	# Relay and the WebSocket proxy, the REST API and the identity provider
	@backend path /relay* /ws-proxy/* /api/* /oauth2/*
	reverse_proxy @backend netbird-server:80
	# Everything else: the dashboard
	reverse_proxy dashboard:80
}
