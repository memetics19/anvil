#!/usr/sbin/nft -f
# Managed by anvil (role netbird_server). Connections the Proxmox host forwards to Caddy
# (TCP {{ netbird_server_https_port }} on this VM's lab address) are marked, and their
# replies carry the mark, so the ip rule of anvil-netbird-reply.service sends them back
# through the main table (the Proxmox host). Without it a reply to a home address follows
# the NetBird cloud client's route for the home network into its tunnel and is lost.
table inet anvil_netbird_reply
delete table inet anvil_netbird_reply

table inet anvil_netbird_reply {
	chain prerouting {
		type filter hook prerouting priority mangle; policy accept;
		ip daddr {{ site.hosts[inventory_hostname].ip }} tcp dport {{ netbird_server_https_port }} ct state new ct mark set {{ netbird_server_reply_mark }}
		ct mark {{ netbird_server_reply_mark }} meta mark set {{ netbird_server_reply_mark }}
	}
}
