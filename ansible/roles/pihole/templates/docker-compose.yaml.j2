# Managed by Ansible (role pihole). Pi-hole answers DNS on the published addresses and
# forwards only to Unbound, which has a fixed address on the project's own network, so
# either container can restart or be recreated on its own.
services:
  pihole:
    image: {{ pihole_image }}
    container_name: pihole
    hostname: pihole
    restart: unless-stopped
    depends_on:
      - unbound
    networks:
      - dns
    ports:
{% for ip in pihole_listen_ips %}
      - "{{ ip }}:53:53/tcp"
      - "{{ ip }}:53:53/udp"
{% if pihole_web_published | bool %}
      - "{{ ip }}:{{ pihole_web_port }}:80/tcp"
{% endif %}
{% endfor %}
    environment:
      TZ: {{ pihole_tz | to_json }}
      # Its own uid, not the image default 1000 (the VM's first user).
      PIHOLE_UID: "{{ pihole_uid }}"
      PIHOLE_GID: "{{ pihole_uid }}"
      FTLCONF_dns_upstreams: "{{ pihole_unbound_ip }}#53"
      # Bridge networking: queries arrive from the clients' own subnets.
      FTLCONF_dns_listeningMode: ALL
      # Unbound validates DNSSEC.
      FTLCONF_dns_dnssec: "false"
      # Local records (dns.hosts) and the rate limit are not set here: the role applies them
      # live (tasks/records_apply.yml, tasks/settings_apply.yml), so a change never
      # recreates the container.
      FTLCONF_dhcp_active: "false"
    # FTLCONF_webserver_api_password (from Vault).
    env_file: pihole.env
    volumes:
      - ./etc-pihole:/etc/pihole
    mem_limit: {{ pihole_mem_limit }}
    memswap_limit: {{ pihole_mem_limit }}

  unbound:
    image: {{ pihole_unbound_image }}
    container_name: unbound
    restart: unless-stopped
    networks:
      dns:
        ipv4_address: {{ pihole_unbound_ip }}
    volumes:
      - ./unbound:/etc/unbound/custom.conf.d:ro
    # Liveness: Unbound answers its built-in localhost zone (no upstream needed).
    healthcheck:
      test: ["CMD", "drill-hc", "@127.0.0.1", "localhost"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    mem_limit: {{ pihole_unbound_mem_limit }}
    memswap_limit: {{ pihole_unbound_mem_limit }}

networks:
  dns:
    ipam:
      config:
        - subnet: {{ pihole_dns_subnet }}
