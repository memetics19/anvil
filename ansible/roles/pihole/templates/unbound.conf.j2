# Managed by Ansible (role pihole). Read after the image's own unbound.conf (listens on
# port 53 in its container, recursive resolver from the root hints, DNSSEC validation,
# private-address rebinding protection, access for private source addresses only).
server:
    msg-cache-size: {{ pihole_unbound_msg_cache }}
    rrset-cache-size: {{ pihole_unbound_rrset_cache }}
