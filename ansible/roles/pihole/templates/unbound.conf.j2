# Managed by Ansible (role pihole). Read after the image's own unbound.conf (recursive
# resolver from the root hints, DNSSEC validation, private-address rebinding protection).
server:
    # Inside Pi-hole's network namespace; Pi-hole owns port 53 there.
    port: {{ pihole_unbound_port }}
    msg-cache-size: {{ pihole_unbound_msg_cache }}
    rrset-cache-size: {{ pihole_unbound_rrset_cache }}
