#!/usr/sbin/nft -f
# Managed by anvil (role canary). The real SSH answers only these sources. Everyone else meets
# the fake services. Connections already open are not touched.
table inet {{ canary_ssh_guard_table }}
delete table inet {{ canary_ssh_guard_table }}
table inet {{ canary_ssh_guard_table }} {
	chain input {
		type filter hook input priority filter - 1; policy accept;
		ct state established,related accept
		tcp dport 22 ip saddr { {{ canary_ssh_sources | join(', ') }} } accept
		tcp dport 22 counter drop
	}
}
