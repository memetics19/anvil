# Managed by anvil (role wazuh_server). Only the users the stack needs: admin (the manager and
# the dashboard login), kibanaserver (the dashboard itself) and grafana (read-only, Grafana on
# the monitoring VM). The demo users are gone.
# The indexer reads this on its first start. Later changes need securityadmin
# (docs/services.md, Wazuh).
---
_meta:
  type: "internalusers"
  config_version: 2
admin:
  hash: "{{ wazuh_server_hashes.admin }}"
  reserved: true
  backend_roles:
  - "admin"
  description: "Administrator"
kibanaserver:
  hash: "{{ wazuh_server_hashes.kibanaserver }}"
  reserved: true
  description: "The dashboard's own user"
grafana:
  hash: "{{ wazuh_server_hashes.grafana }}"
  reserved: false
  backend_roles:
  - "readall"
  description: "Grafana, read-only"
