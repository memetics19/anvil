# network interface settings; autogenerated
# Please do NOT modify this file directly, unless you know what
# you're doing.
#
# If you want to manage parts of the network configuration manually,
# please utilize the 'source' or 'source-directory' directives to do
# so.
# PVE will preserve these directives, but will NOT read its network
# configuration from sourced files, so do not attempt to move any of
# the PVE managed interfaces into external files!

auto lo
iface lo inet loopback

iface eno1 inet manual

iface eno2 inet manual

auto vmbr0
iface vmbr0 inet static
	bridge-vlan-aware yes
	address {{ site.pve.ip }}/{{ site.lan_cidr.split('/')[1] }}
	address {{ site.pve.gateway_alias_ip }}/{{ site.lan_cidr.split('/')[1] }}
	address {{ site.pve.uplink_ip }}/{{ site.pve.uplink_prefix }}
	gateway {{ site.pve.uplink_gw }}
	bridge-ports eno1
	bridge-stp off
	bridge-fd 0
	post-up sysctl -w net.ipv4.ip_forward=1 net.ipv4.conf.all.send_redirects=0 net.ipv4.conf.vmbr0.send_redirects=0
	post-up iptables -t nat -C POSTROUTING -s {{ site.lan_cidr }} ! -d {{ site.lan_cidr }} -j SNAT --to-source {{ site.pve.uplink_ip }} 2>/dev/null || iptables -t nat -A POSTROUTING -s {{ site.lan_cidr }} ! -d {{ site.lan_cidr }} -j SNAT --to-source {{ site.pve.uplink_ip }}
	post-down while iptables -t nat -C POSTROUTING -s {{ site.lan_cidr }} ! -d {{ site.lan_cidr }} -j SNAT --to-source {{ site.pve.uplink_ip }} 2>/dev/null; do iptables -t nat -D POSTROUTING -s {{ site.lan_cidr }} ! -d {{ site.lan_cidr }} -j SNAT --to-source {{ site.pve.uplink_ip }}; done
	post-up iptables -t nat -C PREROUTING -d {{ site.pve.uplink_ip }}/32 -p tcp -m multiport --dports {{ iptv_threadfin_port }},{{ iptv_streams_port }} -j DNAT --to-destination {{ site.hosts[iptv_host].ip }} 2>/dev/null || iptables -t nat -A PREROUTING -d {{ site.pve.uplink_ip }}/32 -p tcp -m multiport --dports {{ iptv_threadfin_port }},{{ iptv_streams_port }} -j DNAT --to-destination {{ site.hosts[iptv_host].ip }}
	post-up iptables -C FORWARD -i vmbr0 -d {{ site.hosts[iptv_host].ip }}/32 -p tcp -m multiport --dports {{ iptv_threadfin_port }},{{ iptv_streams_port }} -m conntrack --ctstate DNAT -j ACCEPT 2>/dev/null || iptables -A FORWARD -i vmbr0 -d {{ site.hosts[iptv_host].ip }}/32 -p tcp -m multiport --dports {{ iptv_threadfin_port }},{{ iptv_streams_port }} -m conntrack --ctstate DNAT -j ACCEPT
	post-down while iptables -t nat -C PREROUTING -d {{ site.pve.uplink_ip }}/32 -p tcp -m multiport --dports {{ iptv_threadfin_port }},{{ iptv_streams_port }} -j DNAT --to-destination {{ site.hosts[iptv_host].ip }} 2>/dev/null; do iptables -t nat -D PREROUTING -d {{ site.pve.uplink_ip }}/32 -p tcp -m multiport --dports {{ iptv_threadfin_port }},{{ iptv_streams_port }} -j DNAT --to-destination {{ site.hosts[iptv_host].ip }}; done
	post-down while iptables -C FORWARD -i vmbr0 -d {{ site.hosts[iptv_host].ip }}/32 -p tcp -m multiport --dports {{ iptv_threadfin_port }},{{ iptv_streams_port }} -m conntrack --ctstate DNAT -j ACCEPT 2>/dev/null; do iptables -D FORWARD -i vmbr0 -d {{ site.hosts[iptv_host].ip }}/32 -p tcp -m multiport --dports {{ iptv_threadfin_port }},{{ iptv_streams_port }} -m conntrack --ctstate DNAT -j ACCEPT; done

auto vmbr1
iface vmbr1 inet manual
	bridge-ports none
	bridge-stp off
	bridge-fd 0
	bridge-vlan-aware yes
	bridge-vids 2-4094

source /etc/network/interfaces.d/*
