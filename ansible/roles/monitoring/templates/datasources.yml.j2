# Managed by anvil (role monitoring). VictoriaMetrics (Prometheus's query API) for the
# dashboards, and Alertmanager, where Grafana shows the alerts and sets silences.
apiVersion: 1
datasources:
  - name: VictoriaMetrics
    uid: victoriametrics
    type: prometheus
    access: proxy
    url: http://victoriametrics:8428
    isDefault: true
    editable: false
    jsonData:
      timeInterval: {{ monitoring_scrape_interval }}
  - name: Alertmanager
    uid: alertmanager
    type: alertmanager
    access: proxy
    url: http://alertmanager:9093
    editable: false
    jsonData:
      implementation: prometheus
