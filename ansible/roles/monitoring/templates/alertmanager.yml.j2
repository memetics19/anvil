# Managed by anvil (role monitoring). Alertmanager groups the alerts and sends them to ntfy
# (docs/monitoring.md, Alerts). Critical: at once, on its own topic, at top priority.
# Warning: held for the morning window, one message per kind of alert.
route:
  receiver: ntfy-critical
  group_by: [alertname, host]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers: ['severity="warning"']
      receiver: ntfy-warning
      group_by: [alertname]
      group_wait: 1m
      group_interval: 1h
      repeat_interval: 24h
      active_time_intervals: [morning]

time_intervals:
  - name: morning
    time_intervals:
      - times:
          - start_time: "{{ monitoring_warning_window_utc.start }}"
            end_time: "{{ monitoring_warning_window_utc.end }}"

# One message per problem: while a host is down, its other alerts are held back.
inhibit_rules:
  - source_matchers: ['alertname="HostDown"']
    target_matchers: ['alertname!="HostDown"']
    equal: [host]

receivers:
  - name: ntfy-critical
    webhook_configs:
      - url: "{{ monitoring_ntfy.url | regex_replace('/+$', '') }}/{{ monitoring_ntfy_topic_critical }}?template=alertmanager&priority=urgent&tags=rotating_light"
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials_file: /etc/alertmanager/ntfy-token
  - name: ntfy-warning
    webhook_configs:
      - url: "{{ monitoring_ntfy.url | regex_replace('/+$', '') }}/{{ monitoring_ntfy_topic_warning }}?template=alertmanager&priority=default&tags=warning"
        send_resolved: false
        http_config:
          authorization:
            type: Bearer
            credentials_file: /etc/alertmanager/ntfy-token
