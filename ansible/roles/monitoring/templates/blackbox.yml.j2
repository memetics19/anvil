# Managed by anvil (role monitoring). How the blackbox exporter checks (docs/monitoring.md,
# Internet). vmagent names the target and the module on every scrape.
modules:
  icmp:
    prober: icmp
    timeout: 5s
    icmp:
      preferred_ip_protocol: ip4
  dns:
    prober: dns
    timeout: 5s
    dns:
      query_name: "{{ monitoring_dns_query }}"
      query_type: A
      preferred_ip_protocol: ip4
      valid_rcodes: [NOERROR]
  http:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      valid_status_codes: [200, 204]
      follow_redirects: false
  # A gateway service answers: any status below 500 (a 401 or a redirect is a running app).
  service:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      follow_redirects: false
      valid_status_codes: [200, 201, 204, 301, 302, 303, 307, 308, 400, 401, 403, 404, 405]
  # The same, for an upstream with its own self-signed certificate (Proxmox, Wazuh, Vault).
  service_insecure:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      follow_redirects: false
      valid_status_codes: [200, 201, 204, 301, 302, 303, 307, 308, 400, 401, 403, 404, 405]
      tls_config:
        insecure_skip_verify: true
  # A service whose TLS Go cannot speak (monitoring_service_tcp): its port accepts a connection.
  service_tcp:
    prober: tcp
    timeout: 5s
    tcp:
      preferred_ip_protocol: ip4
