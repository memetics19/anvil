# Managed by anvil (role monitoring). What vmagent scrapes, every {{ monitoring_scrape_interval }}.
global:
  scrape_interval: {{ monitoring_scrape_interval }}

scrape_configs:
  # CPU, memory, disks and network of every host (node_exporter).
  - job_name: node
    static_configs:
{% for t in monitoring_node_targets %}
      - targets: ["{{ t.address }}"]
        labels: {host: "{{ t.name }}"}
{% endfor %}
{% if monitoring_netbird_server_target | length > 0 %}

  # The self-hosted NetBird server: management, signal and relay (dashboard NetBird).
  - job_name: netbird_server
    static_configs:
      - targets: ["{{ monitoring_netbird_server_target }}"]
        labels: {host: netbird}
{% endif %}

  # The internet and DNS (blackbox exporter): one job per kind of check. Each target is sent to
  # the exporter as ?target=, and named by its probe label.
{% for job, module, targets in [('ping', 'icmp', monitoring_ping_targets), ('dns', 'dns', monitoring_dns_targets), ('http', 'http', monitoring_http_targets)] %}
  - job_name: {{ job }}
    metrics_path: /probe
    params:
      module: [{{ module }}]
    static_configs:
{% for t in targets if (t.address | default(t.url | default(''))) | length > 0 %}
      - targets: ["{{ t.address | default(t.url) }}"]
        labels: {probe: "{{ t.name }}"{% if t.scope is defined %}, scope: "{{ t.scope }}"{% endif %}}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - target_label: __address__
        replacement: blackbox:9115
{% endfor %}

{% if monitoring_frigate_target | length > 0 %}
  # Frigate: cameras, detection, recording storage (role frigate_stack). Labelled host
  # frigate, so a down VM (HostDown) holds back its Frigate alerts. The per-process series
  # carry the ffmpeg command line, with each camera's address, and a pid that changes on every
  # restart: both labels are dropped, and so are the "Other" helper processes.
  - job_name: frigate
    metrics_path: /api/metrics
    static_configs:
      - targets: ["{{ monitoring_frigate_target }}"]
        labels: {host: frigate}
    metric_relabel_configs:
      - source_labels: [__name__, type]
        regex: "frigate_(cpu|mem)_usage_percent;Other"
        action: drop
      - source_labels: [pid]
        regex: frigate\.full_system
        target_label: name
        replacement: full_system
      - regex: cmdline|pid
        action: labeldrop
{% endif %}

{% if monitoring_pihole_target | length > 0 %}
  # Pi-hole (role pihole's exporter): queries, blocks, clients, upstreams, top domains. Labelled
  # host apps, so a down apps VM (HostDown) holds back its Pi-hole alerts.
  - job_name: pihole
    static_configs:
      - targets: ["{{ monitoring_pihole_target }}"]
        labels: {host: apps}

{% endif %}
  # Disk health on the Proxmox nodes (role smartctl_exporter). It reads the disks every 5
  # minutes and answers from that, so a scrape a minute costs the disks nothing.
  - job_name: smart
    static_configs:
{% for t in monitoring_smart_targets %}
      - targets: ["{{ t.address }}"]
        labels: {host: "{{ t.name }}"}
{% endfor %}

  # Every gateway service (blackbox, the SLA dashboard): at its own address, or through the gateway.
{% for module in ['service', 'service_insecure', 'service_tcp'] %}
{% set targets = monitoring_service_targets | selectattr('module', 'equalto', module) | list %}
{% if targets | length > 0 %}
  - job_name: {{ module }}
    metrics_path: /probe
    params:
      module: [{{ module }}]
    static_configs:
{% for t in targets %}
      - targets: ["{{ t.url }}"]
        labels: {service: "{{ t.service }}", host: "{{ t.host }}", via: "{{ t.via }}"}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - target_label: __address__
        replacement: blackbox:9115
      # One job name for both modules, so every query reads job="service".
      - target_label: job
        replacement: service
{% endif %}
{% endfor %}

  # Internet speed (prometheus_speedtest): a full speed test per scrape, so a long interval. Its
  # metric names are generic, so they get a speedtest_ prefix.
  - job_name: speedtest
    scrape_interval: {{ monitoring_speedtest_interval }}
    scrape_timeout: 2m
    metrics_path: /probe
    static_configs:
      - targets: ["speedtest:9516"]
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: (download_speed_bps|upload_speed_bps|ping_ms|bytes_received|bytes_sent)
        target_label: __name__
        replacement: speedtest_$1

  # The stack itself.
  - job_name: victoriametrics
    static_configs:
      - targets: ["victoriametrics:8428"]
  - job_name: vmagent
    static_configs:
      - targets: ["localhost:8429"]
  - job_name: blackbox
    static_configs:
      - targets: ["blackbox:9115"]
