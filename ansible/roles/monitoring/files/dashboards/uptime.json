         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "victoriametrics"
               },
               "expr": "sum(1440 * (1 - avg_over_time(max by (service) (probe_success{job=\"service\"})[1d:5m])))",
               "legendFormat": "Services",
               "refId": "A"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "victoriametrics"
               },
               "expr": "sum(1440 * (1 - avg_over_time(max by (host) (up{job=\"node\"})[1d:5m])))",
               "legendFormat": "Hosts",
               "refId": "B"
            }
         ],
         "title": "Minutes down per day, all services together",
         "type": "timeseries"
