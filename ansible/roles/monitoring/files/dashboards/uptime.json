      {
         "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
         },
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "thresholds"
               },
               "custom": {
                  "drawStyle": "bars",
                  "fillOpacity": 80,
                  "lineWidth": 0,
                  "thresholdsStyle": {
                     "mode": "off"
                  }
               },
               "min": 0,
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "orange",
                        "value": 15
                     },
                     {
                        "color": "red",
