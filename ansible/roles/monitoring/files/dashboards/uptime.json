               "expr": "label_replace(100 * avg_over_time(max(probe_success{job=\"ping\",scope=\"internet\"})[1d:1m]), \"probe\", \"internet\", \"\", \"\")\nor 100 * avg_over_time(max by (probe) (probe_success{job=\"ping\",probe=\"router\"})[1d:1m])\n",
