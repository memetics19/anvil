{
   "description": "The home automation hub on the assistant VM: up, entities, what is on, automation activity, sensors, batteries, and the VM's own health. Managed by anvil: change dashboards/ha.jsonnet.",
   "editable": false,
   "panels": [
      {
         "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
         },
         "fieldConfig": {
            "defaults": {
               "mappings": [
                  {
                     "options": {
                        "0": {
                           "text": "Down"
                        },
                        "1": {
                           "text": "Up"
                        }
                     },
                     "type": "value"
                  }
               ],
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "red",
                        "value": null
                     },
                     {
                        "color": "green",
                        "value": 1
                     }
                  ]
               },
               "unit": "none"
            }
         },
         "gridPos": {
            "h": 5,
            "w": 4,
            "x": 0,
            "y": 0
