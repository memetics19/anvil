{
   "description": "Every host's CPU, memory, disks and network (node_exporter). Managed by anvil: change dashboards/hosts.jsonnet.",
   "editable": false,
   "panels": [
      {
         "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
         },
         "fieldConfig": {
            "defaults": {
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "red",
                        "value": null
                     },
                     {
                        "color": "green",
                        "value": 1
                     }
                  ]
               },
               "unit": "none"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 12,
            "x": 0,
            "y": 0
         },
         "id": 1,
         "options": {
            "colorMode": "background",
            "graphMode": "none",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            },
            "textMode": "value_and_name"
         },
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "victoriametrics"
               },
               "expr": "up{job=\"node\",host=~\"$host\"}",
               "legendFormat": "{{host}}"
            }
         ],
         "title": "Up",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "s"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 12,
            "x": 12,
            "y": 0
         },
         "id": 2,
         "options": {
            "colorMode": "background",
            "graphMode": "none",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            },
            "textMode": "value_and_name"
         },
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "victoriametrics"
               },
               "expr": "time() - node_boot_time_seconds{host=~\"$host\"}",
               "legendFormat": "{{host}}"
            }
         ],
         "title": "Uptime",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
         },
         "fieldConfig": {
            "defaults": {
               "max": 100,
               "min": 0,
               "unit": "percent"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 4
         },
         "id": 3,
         "options": {
            "legend": {
               "calcs": [
                  "lastNotNull",
                  "max"
               ],
               "displayMode": "table",
               "placement": "right"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "victoriametrics"
               },
               "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\",host=~\"$host\"}[5m])))",
               "legendFormat": "{{host}}"
            }
         ],
         "title": "CPU busy",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
         },
         "fieldConfig": {
            "defaults": {
               "max": 100,
               "min": 0,
               "unit": "percent"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 4
         },
         "id": 4,
         "options": {
            "legend": {
               "calcs": [
                  "lastNotNull",
                  "max"
               ],
               "displayMode": "table",
               "placement": "right"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "victoriametrics"
               },
               "expr": "100 * (1 - node_memory_MemAvailable_bytes{host=~\"$host\"} / node_memory_MemTotal_bytes{host=~\"$host\"})",
               "legendFormat": "{{host}}"
            }
         ],
         "title": "Memory used",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
         },
         "fieldConfig": {
            "defaults": {
               "max": 100,
               "min": 0,
               "thresholds": {
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "orange",
                        "value": 80
                     },
                     {
                        "color": "red",
                        "value": 90
                     }
                  ]
               },
               "unit": "percent"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 12
         },
         "id": 5,
         "options": {
            "legend": {
               "calcs": [
                  "lastNotNull",
                  "max"
               ],
               "displayMode": "table",
               "placement": "right"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "victoriametrics"
               },
               "expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|devtmpfs|efivarfs|ramfs\",host=~\"$host\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|devtmpfs|efivarfs|ramfs\",host=~\"$host\"})",
               "legendFormat": "{{host}} {{mountpoint}}"
            }
         ],
         "title": "Disk space used",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "none"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 12
         },
         "id": 6,
         "options": {
            "legend": {
               "calcs": [
                  "lastNotNull",
                  "max"
               ],
               "displayMode": "table",
               "placement": "right"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "victoriametrics"
               },
               "expr": "node_load5{host=~\"$host\"} / count by (host) (node_cpu_seconds_total{mode=\"idle\",host=~\"$host\"})",
               "legendFormat": "{{host}}"
            }
         ],
         "title": "Load per core (5 min)",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "Bps"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 20
         },
         "id": 7,
         "options": {
            "legend": {
               "calcs": [
                  "lastNotNull",
                  "max"
               ],
               "displayMode": "table",
               "placement": "right"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "victoriametrics"
               },
               "expr": "sum by (host) (rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br-.*|fwbr.*|fwpr.*|fwln.*|tap.*|wt.*\",host=~\"$host\"}[5m]))",
               "legendFormat": "{{host}}"
            }
         ],
         "title": "Network in",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "Bps"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 20
         },
         "id": 8,
         "options": {
            "legend": {
               "calcs": [
                  "lastNotNull",
                  "max"
               ],
               "displayMode": "table",
               "placement": "right"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "victoriametrics"
               },
               "expr": "sum by (host) (rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*|br-.*|fwbr.*|fwpr.*|fwln.*|tap.*|wt.*\",host=~\"$host\"}[5m]))",
               "legendFormat": "{{host}}"
            }
         ],
         "title": "Network out",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "Bps"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 28
         },
         "id": 9,
         "options": {
            "legend": {
               "calcs": [
                  "lastNotNull",
                  "max"
               ],
               "displayMode": "table",
               "placement": "right"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "victoriametrics"
               },
               "expr": "sum by (host) (rate(node_disk_read_bytes_total{host=~\"$host\"}[5m]))",
               "legendFormat": "{{host}}"
            }
         ],
         "title": "Disk reads",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "Bps"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 28
         },
         "id": 10,
         "options": {
            "legend": {
               "calcs": [
                  "lastNotNull",
                  "max"
               ],
               "displayMode": "table",
               "placement": "right"
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "victoriametrics"
               },
               "expr": "sum by (host) (rate(node_disk_written_bytes_total{host=~\"$host\"}[5m]))",
               "legendFormat": "{{host}}"
            }
         ],
         "title": "Disk writes",
         "type": "timeseries"
      }
   ],
   "refresh": "1m",
   "schemaVersion": 39,
   "tags": [
      "anvil",
      "node_exporter"
   ],
   "templating": {
      "list": [
         {
            "allValue": ".*",
            "datasource": {
               "type": "prometheus",
               "uid": "victoriametrics"
            },
            "includeAll": true,
            "label": "Host",
            "multi": true,
            "name": "host",
            "query": "label_values(node_uname_info, host)",
            "refresh": 2,
            "sort": 1,
            "type": "query"
         }
      ]
   },
   "time": {
      "from": "now-24h",
      "to": "now"
   },
   "timezone": "browser",
   "title": "Hosts",
   "uid": "anvil-hosts"
}
