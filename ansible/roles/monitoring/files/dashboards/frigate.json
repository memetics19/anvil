      {
         "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
         },
         "fieldConfig": {
            "defaults": {
               "mappings": [
                  {
                     "options": {
                        "0": {
                           "text": "Down"
                        },
                        "1": {
                           "text": "Up"
                        }
                     },
                     "type": "value"
                  }
               ],
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "red",
                        "value": null
                     },
                     {
                        "color": "green",
                        "value": 1
                     }
                  ]
               },
               "unit": "none"
            }
         },
         "gridPos": {
            "h": 5,
            "w": 6,
            "x": 0,
            "y": 0
         },
         "id": 1,
         "options": {
            "colorMode": "background",
            "graphMode": "none",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            },
            "textMode": "value_and_name"
