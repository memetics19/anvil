# Managed by Ansible (role pve_segments). Loads the routed segments' nftables table at boot,
# before the network comes up and before Proxmox starts the guests. After editing the
# ruleset: systemctl restart segments-firewall, then start every segments-set-refresh@<set>
# (a reload empties the DNS-fed sets).
[Unit]
Description=Routed segments firewall (nftables table inet {{ pve_segments_table }})
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target pve-guests.service shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f {{ pve_segments_etc }}/segments.nft

[Install]
WantedBy=multi-user.target
