# Managed by Ansible (role home_link). The home router's WireGuard, for the home subnet only.
[Interface]
PrivateKey = {{ home_link_peer.private_key }}
Address = {{ home_link_peer.address }}

[Peer]
PublicKey = {{ home_link_peer.peer_public_key }}
{% if home_link_peer.preshared_key | default('') %}
PresharedKey = {{ home_link_peer.preshared_key }}
{% endif %}
Endpoint = {{ home_link_peer.endpoint }}
AllowedIPs = {{ home_link_peer.home_subnet }}
PersistentKeepalive = {{ home_link_keepalive }}
