#!/usr/sbin/nft -f
# Managed by anvil (role camera_egress_guard). The cameras use this host as their gateway.
# They may answer connections Frigate opened and ask for the time. Every other packet they
# send through this host is dropped and counted: nothing they see leaves the house.
table inet {{ camera_egress_guard_table }}
delete table inet {{ camera_egress_guard_table }}
table inet {{ camera_egress_guard_table }} {
	set cameras {
		type ipv4_addr
		elements = { {{ camera_egress_guard_cameras | join(', ') }} }
	}
	chain forward {
		type filter hook forward priority filter - 2; policy accept;
		# Replies to Frigate, which opens every connection to a camera.
		ip saddr @cameras ct state established,related counter accept
{% if camera_egress_guard_allow_ntp %}
		ip saddr @cameras udp dport 123 counter accept
{% endif %}
		ip saddr @cameras counter drop
	}
}
