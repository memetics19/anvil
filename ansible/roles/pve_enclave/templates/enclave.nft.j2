#!/usr/sbin/nft -f
# Managed by Ansible (role pve_enclave). The secrets enclave's firewall: one table, replaced
# as a whole in one transaction (the first two lines make that work when it does not exist
# yet). Only packets to, from or through the vnet `{{ pve_enclave_vnet }}` are looked at;
# everything else passes these chains untouched (accept here is not final: the host's other
# rules still apply). The enclave has no NAT: nothing it sends can reach the internet even if
# a rule here were wrong. Loaded at boot by enclave-firewall.service.
{% set v = pve_enclave_vnet %}
{% set vault_ip = site.hosts[pve_enclave_vault_host].ip | default('') %}
{% set vw_ip = (site.hosts[pve_enclave_vaultwarden_host] | default({})).ip | default('') %}
{% set gw_ip = site.hosts[pve_enclave_gateway_host].ip %}
{% set dns_ip = site.hosts[pve_enclave_dns_host].ip %}
{% set mon_ip = (site.hosts[pve_enclave_monitoring_host] | default({})).ip | default('') %}
{% set members = [vault_ip, vw_ip] | select | list %}
{% set exclude = pve_enclave_admin_exclude_hosts | map('extract', site.hosts) | map(attribute='ip') | list %}
table inet enclave
delete table inet enclave
table inet enclave {
	# Operators (site.admin_sources).
	set admin {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { {{ pve_enclave_admin_sources | join(', ') }} }
	}

	# Lab VMs inside those ranges that are not operators.
	set not_admin {
		type ipv4_addr
{% if exclude %}
		elements = { {{ exclude | join(', ') }} }
{% endif %}
	}

	# The SMTP relay's addresses (enclave-smtp-relay.timer adds them, each with a timeout).
	set smtp_relay {
		type ipv4_addr
		flags timeout
	}

	chain forward {
		type filter hook forward priority filter; policy accept;
		oifname "{{ v }}" jump into_enclave
		iifname "{{ v }}" jump out_of_enclave
	}

	# New connections into the enclave.
	chain into_enclave {
		ct state established,related accept
		# The service gateway (Caddy on {{ pve_enclave_gateway_host }}).
		ip saddr {{ gw_ip }} ip daddr {{ vault_ip }} tcp dport {{ pve_enclave_vault_port }} accept
{% if vw_ip %}
		ip saddr {{ gw_ip }} ip daddr {{ vw_ip }} tcp dport {{ pve_enclave_vaultwarden_port }} accept
{% endif %}
		# Operators: Vault's API, SSH and ping on both VMs.
		ip saddr @not_admin counter drop
		ip saddr @admin ip daddr {{ vault_ip }} tcp dport {{ pve_enclave_vault_port }} accept
		ip saddr @admin ip daddr { {{ members | join(', ') }} } tcp dport {{ pve_enclave_ssh_port }} accept
		ip saddr @admin ip daddr { {{ members | join(', ') }} } icmp type echo-request accept
{% if mon_ip %}
		# Monitoring: node_exporter on both VMs and Vault's metrics.
		ip saddr {{ mon_ip }} ip daddr { {{ members | join(', ') }} } tcp dport {{ pve_enclave_node_exporter_port }} accept
		ip saddr {{ mon_ip }} ip daddr {{ vault_ip }} tcp dport {{ pve_enclave_vault_port }} accept
{% endif %}
		counter drop
	}

	# New connections out of the enclave (routed): Vault none; Vaultwarden DNS to Pi-hole and
	# SMTP to the relay only.
	chain out_of_enclave {
		ct state established,related accept
{% if vw_ip %}
		ip saddr {{ vw_ip }} ip daddr {{ dns_ip }} udp dport 53 accept
		ip saddr {{ vw_ip }} ip daddr {{ dns_ip }} tcp dport 53 accept
		ip saddr {{ vw_ip }} ip daddr @smtp_relay tcp dport {{ pve_enclave_smtp_port }} accept
{% endif %}
		counter drop
	}

	chain input {
		type filter hook input priority filter; policy accept;
		iifname "{{ v }}" jump enclave_to_host
		# The gateway address answers on the vnet only.
		ip daddr {{ pve_enclave_gateway }} iifname != { "{{ v }}", "lo" } counter drop
	}

	# From the enclave to this host: NTP and the apt cache on the gateway address, ping, and
	# (Vaultwarden only) the Ceph S3 gateway for its backups.
	chain enclave_to_host {
		ct state established,related accept
		ip daddr {{ pve_enclave_gateway }} udp dport 123 accept
		ip daddr {{ pve_enclave_gateway }} tcp dport {{ pve_enclave_aptcache_port }} accept
		ip daddr {{ pve_enclave_gateway }} icmp type echo-request accept
{% if vw_ip %}
		ip saddr {{ vw_ip }} ip daddr {{ site.pve.ip }} tcp dport {{ pve_enclave_rgw_port }} accept
{% endif %}
		counter drop
	}
}
