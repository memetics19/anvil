# Managed by Ansible (role pve_enclave). Adds the SMTP relay's current addresses to the
# nftables set inet enclave smtp_relay (see /usr/local/sbin/enclave-smtp-relay).
[Unit]
Description=Refresh the secrets enclave's SMTP relay set
After=enclave-firewall.service network-online.target
Requires=enclave-firewall.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/enclave-smtp-relay {{ pve_enclave_etc }}/smtp-relay.conf
