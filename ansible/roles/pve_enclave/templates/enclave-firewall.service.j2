# Managed by Ansible (role pve_enclave). Loads the secrets enclave's nftables table at boot,
# before the network comes up and before Proxmox starts the guests. Reload after editing
# the ruleset: systemctl restart enclave-firewall, then systemctl start enclave-smtp-relay
# (a reload empties the SMTP relay set).
[Unit]
Description=Secrets enclave firewall (nftables table inet enclave)
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target pve-guests.service shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f {{ pve_enclave_etc }}/enclave.nft

[Install]
WantedBy=multi-user.target
