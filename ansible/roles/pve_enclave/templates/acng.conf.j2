# Managed by Ansible (role pve_enclave). apt-cacher-ng for the secrets enclave: the enclave's
# one HTTP path out, for Debian and Ubuntu archives only. It listens on the enclave gateway
# address only. ForceManaged: only requests for the repositories named in the Remap lines
# below are served (no other host). PassThroughPattern matches nothing: no CONNECT tunnel to
# any host (HTTPS repositories are not reachable through it). AllowUserPorts: port 80 only.
# Each remap names its upstream (after the ;), so whatever mirror host a client asks for, the
# file comes from that one archive host; and no remap matches on a path alone (Debian's
# defaults also match /debian or /ubuntu on any host). ReportPage is empty, and maintenance
# jobs need the AdminAuth login in security.conf anyway.
CacheDir: /var/cache/apt-cacher-ng
LogDir: /var/log/apt-cacher-ng
SupportDir: /usr/lib/apt-cacher-ng
BindAddress: {{ pve_enclave_gateway }}
Port: {{ pve_enclave_aptcache_port }}
# The host has no IPv6 route out: connect upstream over IPv4 only.
ConnectProto: v4
Remap-debrep: file:deb_mirror*.gz deb.debian.org/debian ; http://deb.debian.org/debian/ # Debian archive
Remap-secdeb: security.debian.org/debian-security deb.debian.org/debian-security ; http://deb.debian.org/debian-security/ # Debian security updates
Remap-uburep: file:ubuntu_mirrors archive.ubuntu.com/ubuntu ; http://archive.ubuntu.com/ubuntu/ # Ubuntu archive
Remap-ubusec: security.ubuntu.com/ubuntu ; http://security.ubuntu.com/ubuntu/ # Ubuntu security updates
ForceManaged: 1
PassThroughPattern: ^$
AllowUserPorts: 80
ReportPage:
ExThreshold: 4
FollowIndexFileRemoval: 1
