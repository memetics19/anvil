version: "3.9"

services:
  mqtt:
    image: {{ frigate_stack_mosquitto_image }}
    container_name: mqtt
    restart: unless-stopped
    volumes:
      - ./mosquitto/config:/mosquitto/config
      - ./mosquitto/data:/mosquitto/data
    networks:
      - frigate-network

  frigate:
    image: {{ frigate_stack_frigate_image }}
    container_name: frigate
    shm_size: "256m"
    privileged: true
    restart: unless-stopped
    depends_on:
      - mqtt
    volumes:
      - ./config:/config
      - ./recordings:/media/frigate
      - /etc/localtime:/etc/localtime:ro
    ports:
      # 5000 is Frigate's unauthenticated internal API: loopback only, for this role.
      - "127.0.0.1:5000:5000"
      # 8971 is the authenticated UI: the gateway (lab address) and the host's nginx (loopback).
      - "127.0.0.1:8971:8971"
      - "{{ site.hosts[inventory_hostname].ip }}:8971:8971"
    devices:
      - /dev/bus/usb:/dev/bus/usb
    environment:
      FRIGATE_RTSP_PASSWORD: {{ frigate_stack_compose_rtsp_password }}
    networks:
      - frigate-network

  frigate-notify:
    image: {{ frigate_stack_notify_image }}
    container_name: frigate-notify
    shm_size: "256m"
    restart: unless-stopped
    depends_on:
      - mqtt
      - gotify
    volumes:
      - /home/frigate-notify/config.yml:/config.yml:ro
    environment:
      TZ: {{ frigate_stack_timezone }}
      # frigate-notify v0.5 reads ./config.yml (/app) unless told otherwise. All of its
      # settings, the Gotify token included, are in that file (FN_* variables override it).
      FN_CONFIGFILE: /config.yml
    # Same network as frigate, mqtt and gotify, so their names resolve.
    networks:
      - frigate-network
  gotify:
    image: {{ frigate_stack_gotify_image }}
    container_name: gotify
    restart: unless-stopped
    ports:
      - "{{ site.hosts[inventory_hostname].ip }}:8080:80"
    volumes:
      - ./gotify/data:/app/data
    networks:
      - frigate-network

networks:
  frigate-network:
    driver: bridge
