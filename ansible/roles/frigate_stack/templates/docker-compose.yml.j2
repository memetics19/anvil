version: "3.9"

services:
  mqtt:
    image: eclipse-mosquitto:2
    container_name: mqtt
    restart: unless-stopped
    ports:
      - "1883:1883"
    volumes:
      - ./mosquitto/config:/mosquitto/config
      - ./mosquitto/data:/mosquitto/data
    networks:
      - frigate-network

  frigate:
    image: ghcr.io/blakeblackshear/frigate:stable
    container_name: frigate
    shm_size: "256m"
    privileged: true
    restart: unless-stopped
    depends_on:
      - mqtt
    volumes:
      - ./config:/config
      - ./recordings:/media/frigate
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "5000:5000"
      - "8971:8971"
    devices:
      - /dev/bus/usb:/dev/bus/usb
    environment:
      FRIGATE_RTSP_PASSWORD: {{ frigate_stack_compose_rtsp_password }}
    networks:
      - frigate-network

  frigate-notify:
    image: ghcr.io/0x2142/frigate-notify:latest
    container_name: frigate-notify
    shm_size: "256m"
    restart: unless-stopped
    depends_on:
      - mqtt
      - gotify
    volumes:
      - /home/frigate-notify/config.yml:/config.yml:ro
    environment:
      TZ: {{ frigate_stack_timezone }}
      # frigate-notify v0.5 reads ./config.yml (/app) unless told otherwise. All of its
      # settings, the Gotify token included, are in that file (FN_* variables override it).
      FN_CONFIGFILE: /config.yml
    # Same network as frigate, mqtt and gotify, so their names resolve.
    networks:
      - frigate-network
  gotify:
    image: gotify/server
    container_name: gotify
    restart: unless-stopped
    ports:
      - "8080:80"
    volumes:
      - ./gotify/data:/app/data
    networks:
      - frigate-network

networks:
  frigate-network:
    driver: bridge
