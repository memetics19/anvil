# frigate-notify v0.5 config (mounted at /config.yml). Managed by Ansible (frigate_stack).
app:
  mode: events

frigate:
  server: http://frigate:5000
  startup_check:
    attempts: 5
    interval: 30
  mqtt:
    enabled: true
    server: mqtt
    port: 1883
    topic_prefix: frigate
    username: {{ frigate_stack_secrets.mqtt_user | to_json }}
    password: {{ frigate_stack_secrets.mqtt_password | to_json }}

alerts:
  labels:
    allow:
      - person
  # Home Assistant now owns intrusion alerts (low-noise: front door while away, via the
  # intrusion package). frigate-notify's own Gotify push is off so alerts do not double up and
  # every person on every camera does not notify. Re-enable only if HA is not the source.
  gotify:
    enabled: false
    server: http://gotify
    token: {{ frigate_stack_gotify_token }}
    priority: 8
