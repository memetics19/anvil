# Managed by anvil (ansible role frigate_stack). Frigate's own login guards the UI: requests
# go to its authenticated port (8971, self-signed TLS). Only cloudflared reaches this listener.

# WebSocket upgrade only when the client asks for one.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 127.0.0.1:8443;
    server_name frigate.{{ site.domain }};

    location / {
        proxy_pass https://127.0.0.1:8971;

        # Frigate's certificate is self-signed.
        proxy_ssl_verify off;
        proxy_ssl_server_name on;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
{% if frigate_stack_metrics_sources | length > 0 %}

# Frigate's metrics for the monitoring VM: /api/metrics only, from the internal API.
server {
    listen {{ site.hosts[inventory_hostname].ip }}:{{ frigate_stack_metrics_port }};
{% for s in frigate_stack_metrics_sources %}
    allow {{ s }};
{% endfor %}
    deny all;
    location = /api/metrics {
        proxy_pass http://127.0.0.1:5000/api/metrics;
    }
    location / {
        return 404;
    }
}
{% endif %}
