# Published on the VM's lab address so Home Assistant can subscribe to Frigate's events.
# ufw does not filter Docker-published ports, so the broker is reachable lab-wide: auth is the
# boundary. allow_anonymous is off and every client (Frigate, frigate-notify, HA) logs in.
listener 1883
allow_anonymous false
password_file /mosquitto/config/passwd
persistence true
persistence_location /mosquitto/data/
