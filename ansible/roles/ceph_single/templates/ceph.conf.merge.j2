{#- Current ceph.conf with this role's [global] keys set and the gateway section replaced.
    Regexes avoid backslash escapes: [[] and []] match the brackets, $(?!.) is end of text.
    Keys are only removed inside [global], so e.g. [mon.x] public_addr stays. -#}
{%- set c = namespace(t=(ceph_single_conf_old.content | b64decode)) -%}
{%- set c.t = c.t | regex_replace('(?ms)^[[]client[.]rgw[.]' ~ (ceph_single_rgw_id | regex_escape) ~ '[]][^\n]*\n.*?(?=^[[]|$(?!.))', '') -%}
{%- set g = namespace(old=(c.t | regex_search('(?ms)^[[]global[]][^\n]*\n.*?(?=^[[]|$(?!.))')), new='', keys='') -%}
{%- if g.old -%}
{%- set g.new = g.old -%}
{%- for k, v in ceph_single_global_settings.items() -%}
{%- set g.new = g.new | regex_replace('(?m)^[ \t]*' ~ (k | replace('_', '[ _]')) ~ '[ \t]*=[^\n]*\n?', '') -%}
{%- set g.keys = g.keys ~ '\t ' ~ k ~ ' = ' ~ v ~ '\n' -%}
{%- endfor -%}
{%- set g.new = g.new | regex_replace('^([[]global[]][^\n]*\n)', '\\g<1>' ~ g.keys, count=1) -%}
{%- set c.t = c.t | replace(g.old, g.new, 1) -%}
{%- endif -%}
{{ (c.t | trim) ~ '\n\n' ~ (lookup('ansible.builtin.template', 'rgw.conf.j2') | trim) ~ '\n' }}
