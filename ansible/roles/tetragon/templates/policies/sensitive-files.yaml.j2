# Managed by Ansible (role tetragon). A write to the files that hold logins, privileges and
# scheduled jobs. Audit only: apt, useradd and Ansible write them legitimately.
apiVersion: cilium.io/v1alpha1
kind: TracingPolicy
metadata:
  name: anvil-sensitive-files
spec:
  kprobes:
    - call: security_file_permission
      syscall: false
      args:
        - index: 0
          type: file
        - index: 1
          type: int
      selectors:
        # 2 is MAY_WRITE.
        - matchArgs:
            - index: 0
              operator: Prefix
              values:
                - /etc/shadow
                - /etc/gshadow
                - /etc/sudoers
                - /etc/ssh/sshd_config
                - /etc/cron
                - /var/spool/cron/
                - /root/.ssh/
            - index: 1
              operator: Equal
              values: ["2"]
          matchActions:
            - action: Post
