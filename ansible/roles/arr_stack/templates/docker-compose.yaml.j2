# Managed by anvil (ansible/roles/arr_stack); changes here are overwritten on the next run.
services:
  qbittorrent:
    image: {{ arr_stack_qbittorrent_image }}
    container_name: qbittorrent
    restart: unless-stopped
    ports:
      - "{{ site.hosts[inventory_hostname].ip }}:8080:8080"
      - "{{ site.hosts[inventory_hostname].ip }}:6881:6881"
      - "{{ site.hosts[inventory_hostname].ip }}:6881:6881/udp"
    volumes:
      - ./qbittorrent/config:/config
      - /home/ubuntu/media/downloads:/downloads
    environment:
      - PUID={{ arr_stack_uid }}
      - PGID={{ arr_stack_gid }}
      - TZ={{ arr_stack_timezone }}
      - WEBUI_PORT=8080

  prowlarr:
    image: {{ arr_stack_prowlarr_image }}
    container_name: prowlarr
    restart: unless-stopped
    ports:
      - "{{ site.hosts[inventory_hostname].ip }}:9696:9696"
    volumes:
      - ./prowlarr/config:/config
    environment:
      - PUID={{ arr_stack_uid }}
      - PGID={{ arr_stack_gid }}
      - TZ={{ arr_stack_timezone }}

  jackett:
    image: {{ arr_stack_jackett_image }}
    container_name: jackett
    restart: unless-stopped
    ports:
      - "{{ site.hosts[inventory_hostname].ip }}:9117:9117"
    volumes:
      - ./jackett/config:/config
    environment:
      - PUID={{ arr_stack_uid }}
      - PGID={{ arr_stack_gid }}
      - TZ={{ arr_stack_timezone }}
      - AUTO_UPDATE=true
    depends_on:
      - flaresolverr

  flaresolverr:
    image: {{ arr_stack_flaresolverr_image }}
    container_name: flaresolverr
    restart: unless-stopped
    # Not published: Prowlarr reaches it as flaresolverr:8191 on the compose network.
    environment:
      - LOG_LEVEL=info
      - LOG_HTML=false
      - CAPTCHA_SOLVER=none
      - TZ={{ arr_stack_timezone }}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8191/health"]
      interval: 30s
      timeout: 5s
      retries: 3

  radarr:
    image: {{ arr_stack_radarr_image }}
    container_name: radarr
    restart: unless-stopped
    ports:
      - "{{ site.hosts[inventory_hostname].ip }}:7878:7878"
    volumes:
      - ./radarr/config:/config
      - /home/ubuntu/media/movies:/movies
      - /home/ubuntu/media/downloads:/downloads
    environment:
      - PUID={{ arr_stack_uid }}
      - PGID={{ arr_stack_gid }}
      - TZ={{ arr_stack_timezone }}
    depends_on:
      - qbittorrent

  sonarr:
    image: {{ arr_stack_sonarr_image }}
    container_name: sonarr
    restart: unless-stopped
    ports:
      - "{{ site.hosts[inventory_hostname].ip }}:8989:8989"
    volumes:
      - ./sonarr/config:/config
      - /home/ubuntu/media/tv:/tv
      - /home/ubuntu/media/downloads:/downloads
    environment:
      - PUID={{ arr_stack_uid }}
      - PGID={{ arr_stack_gid }}
      - TZ={{ arr_stack_timezone }}
    depends_on:
      - qbittorrent

  # Subtitles: finds what Sonarr's and Radarr's files lack and saves .srt next to them. It
  # sees the library on the same paths as they do, so no path mapping is needed.
  bazarr:
    image: {{ arr_stack_bazarr_image }}
    container_name: bazarr
    restart: unless-stopped
    ports:
      - "{{ site.hosts[inventory_hostname].ip }}:6767:6767"
    volumes:
      - ./bazarr/config:/config
      - /home/ubuntu/media/movies:/movies
      - /home/ubuntu/media/tv:/tv
    environment:
      - PUID={{ arr_stack_uid }}
      - PGID={{ arr_stack_gid }}
      - TZ={{ arr_stack_timezone }}
    depends_on:
      - sonarr
      - radarr
