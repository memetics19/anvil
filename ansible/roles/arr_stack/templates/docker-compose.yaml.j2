# Managed by anvil (ansible/roles/arr_stack); changes here are overwritten on the next run.
services:
  # ProtonVPN gateway for qBittorrent. qBittorrent shares this container's network, so all its
  # traffic goes through the VPN with a kill-switch (tunnel down => qBit has no network, never
  # the home IP). ProtonVPN's forwarded port (NAT-PMP) is pushed into qBit's listen port so it
  # accepts incoming peers. Custom OpenVPN config (the exact PF-capable server, in Vault): it
  # avoids gluetun's stale server list, and OpenVPN's 10.16.x tunnel avoids the WireGuard
  # 10.2.0.x collision with the lab. Login in gluetun.env (+pmp enables port forwarding).
  gluetun:
    image: {{ arr_stack_gluetun_image }}
    container_name: gluetun
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    ports:
      - "{{ site.hosts[inventory_hostname].ip }}:8080:8080"
    environment:
      VPN_SERVICE_PROVIDER: custom
      VPN_TYPE: openvpn
      OPENVPN_CUSTOM_CONFIG: /gluetun/custom.ovpn
      VPN_PORT_FORWARDING: "on"
      VPN_PORT_FORWARDING_PROVIDER: protonvpn
      FIREWALL_INPUT_PORTS: "8080"
      FIREWALL_OUTBOUND_SUBNETS: "{{ arr_stack_gluetun_outbound_subnets }}"
      TZ: "{{ arr_stack_timezone }}"
      # When ProtonVPN hands over a forwarded port, set it as qBittorrent's listen port. qBit's
      # localhost auth bypass is on (tasks/main.yml), so no login is needed on 127.0.0.1.
      VPN_PORT_FORWARDING_UP_COMMAND: >-
        /bin/sh -c 'wget -q -O- --post-data "json={\"listen_port\":{% raw %}{{PORTS}}{% endraw %}}" http://127.0.0.1:8080/api/v2/app/setPreferences'
    env_file:
      - gluetun.env
    volumes:
      - ./gluetun:/gluetun

  qbittorrent:
    image: {{ arr_stack_qbittorrent_image }}
    container_name: qbittorrent
    restart: unless-stopped
    # No network of its own: it rides the VPN through gluetun (kill-switch). Its WebUI is
    # published by gluetun above; the ARRs reach it as gluetun:8080.
    network_mode: "service:gluetun"
    depends_on:
      gluetun:
        condition: service_healthy
    volumes:
      - ./qbittorrent/config:/config
      - /home/ubuntu/media/downloads:/downloads
    environment:
      - PUID={{ arr_stack_uid }}
      - PGID={{ arr_stack_gid }}
      - TZ={{ arr_stack_timezone }}
      - WEBUI_PORT=8080

  prowlarr:
    image: {{ arr_stack_prowlarr_image }}
    container_name: prowlarr
    restart: unless-stopped
    ports:
      - "{{ site.hosts[inventory_hostname].ip }}:9696:9696"
    volumes:
      - ./prowlarr/config:/config
    environment:
      - PUID={{ arr_stack_uid }}
      - PGID={{ arr_stack_gid }}
      - TZ={{ arr_stack_timezone }}

  jackett:
    image: {{ arr_stack_jackett_image }}
    container_name: jackett
    restart: unless-stopped
    ports:
      - "{{ site.hosts[inventory_hostname].ip }}:9117:9117"
    volumes:
      - ./jackett/config:/config
    environment:
      - PUID={{ arr_stack_uid }}
      - PGID={{ arr_stack_gid }}
      - TZ={{ arr_stack_timezone }}
      - AUTO_UPDATE=true
    depends_on:
      - flaresolverr

  flaresolverr:
    image: {{ arr_stack_flaresolverr_image }}
    container_name: flaresolverr
    restart: unless-stopped
    # Not published: Prowlarr reaches it as flaresolverr:8191 on the compose network.
    environment:
      - LOG_LEVEL=info
      - LOG_HTML=false
      - CAPTCHA_SOLVER=none
      - TZ={{ arr_stack_timezone }}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8191/health"]
      interval: 30s
      timeout: 5s
      retries: 3

  radarr:
    image: {{ arr_stack_radarr_image }}
    container_name: radarr
    restart: unless-stopped
    ports:
      - "{{ site.hosts[inventory_hostname].ip }}:7878:7878"
    volumes:
      - ./radarr/config:/config
      - /home/ubuntu/media/movies:/movies
      - /home/ubuntu/media/downloads:/downloads
    environment:
      - PUID={{ arr_stack_uid }}
      - PGID={{ arr_stack_gid }}
      - TZ={{ arr_stack_timezone }}
    depends_on:
      - qbittorrent

  sonarr:
    image: {{ arr_stack_sonarr_image }}
    container_name: sonarr
    restart: unless-stopped
    ports:
      - "{{ site.hosts[inventory_hostname].ip }}:8989:8989"
    volumes:
      - ./sonarr/config:/config
      - /home/ubuntu/media/tv:/tv
      - /home/ubuntu/media/downloads:/downloads
    environment:
      - PUID={{ arr_stack_uid }}
      - PGID={{ arr_stack_gid }}
      - TZ={{ arr_stack_timezone }}
    depends_on:
      - qbittorrent

  # Subtitles: finds what Sonarr's and Radarr's files lack and saves .srt next to them. It
  # sees the library on the same paths as they do, so no path mapping is needed.
  bazarr:
    image: {{ arr_stack_bazarr_image }}
    container_name: bazarr
    restart: unless-stopped
    ports:
      - "{{ site.hosts[inventory_hostname].ip }}:6767:6767"
    volumes:
      - ./bazarr/config:/config
      - /home/ubuntu/media/movies:/movies
      - /home/ubuntu/media/tv:/tv
    environment:
      - PUID={{ arr_stack_uid }}
      - PGID={{ arr_stack_gid }}
      - TZ={{ arr_stack_timezone }}
    depends_on:
      - sonarr
      - radarr
