# Managed by Ansible (role arr_stack). ProtonVPN OpenVPN login for gluetun, from Vault
# (kv/{{ arr_stack_gluetun_vault_path }}). Never commit real values. The +pmp suffix is
# ProtonVPN's switch to enable NAT-PMP port forwarding over OpenVPN.
OPENVPN_USER={{ arr_stack_gluetun_secrets.openvpn_user }}+pmp
OPENVPN_PASSWORD={{ arr_stack_gluetun_secrets.openvpn_password }}
