# Managed by anvil (ansible/roles/authentik); changes here are overwritten on the next run.
# Single sign-on for the lab. The worker applies this file when it changes and every hour,
# and the role applies it after each change, so an edit in the UI to these objects goes back
# to what is written here. No secret is in this file: the Proxmox client secret comes from
# the worker's environment (authentik.env, mode 600).
version: 1
metadata:
  name: anvil single sign-on
  labels:
    blueprints.goauthentik.io/description: "anvil: the gateway's forward auth and Proxmox"
entries:
  # Members of this group may open every app below. Nobody is added here: add your own
  # user to it in the admin interface.
  - model: authentik_core.group
    id: sso-group
    identifiers:
      name: {{ authentik_sso_group | to_json }}

  # --- a second factor for everyone ---------------------------------------------------------
  # The default login flow's MFA step (made by Authentik's own blueprint, which sets none of
  # these fields, so they stay as written here). A user without a second factor must set one
  # up at the next login: an authenticator app (TOTP) or a passkey or security key (WebAuthn).
  # Recovery codes count as a second factor once made.
  - model: authentik_stages_authenticator_validate.authenticatorvalidatestage
    identifiers:
      name: default-authentication-mfa-validation
    attrs:
      not_configured_action: {{ authentik_mfa_not_configured_action | to_json }}
      device_classes: [totp, webauthn, static]
      configuration_stages:
        - !Find [authentik_stages_authenticator_totp.authenticatortotpstage, [name, default-authenticator-totp-setup]]
        - !Find [authentik_stages_authenticator_webauthn.authenticatorwebauthnstage, [name, default-authenticator-webauthn-setup]]

  # --- the gateway ------------------------------------------------------------------------
  # One proxy provider in domain mode covers every name under the gateway domain: Caddy asks
  # the embedded outpost before each request, and one login sets a cookie for the domain.
  - model: authentik_providers_proxy.proxyprovider
    id: gateway-provider
    identifiers:
      name: anvil-gateway
    attrs:
      mode: forward_domain
      external_host: {{ authentik_external_url | to_json }}
      cookie_domain: {{ gateway_domain | to_json }}
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]

  - model: authentik_core.application
    id: gateway-app
    identifiers:
      slug: lab-gateway
    attrs:
      name: Lab gateway
      provider: !KeyOf gateway-provider
      # Not an app to open by itself: every gateway name uses it.
      meta_hide: true

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf gateway-app
      group: !KeyOf sso-group
    attrs:
      order: 0

  # The embedded outpost (inside the Authentik server, port {{ authentik_port }}) serves the
  # gateway's provider. Its settings are Authentik's defaults, with the address browsers use.
  - model: authentik_outposts.outpost
    identifiers:
      managed: goauthentik.io/outposts/embedded
    attrs:
      providers:
        - !KeyOf gateway-provider
      config:
        authentik_host: {{ authentik_external_url | to_json }}
        authentik_host_browser: ""
        authentik_host_insecure: false
        log_level: info
        refresh_interval: minutes=5
        object_naming_template: ak-outpost-%(name)s
        docker_network: null
        docker_map_ports: true
        docker_labels: null
        container_image: null
        kubernetes_replicas: 1
        kubernetes_namespace: default
        kubernetes_ingress_annotations: {}
        kubernetes_ingress_secret_name: authentik-outpost-tls
        kubernetes_ingress_class_name: null
        kubernetes_ingress_path_type: null
        kubernetes_httproute_annotations: {}
        kubernetes_httproute_parent_refs: []
        kubernetes_service_type: ClusterIP
        kubernetes_disabled_components: []
        kubernetes_image_pull_secrets: []
        kubernetes_json_patches: null
        kubernetes_disable_x509_strict: false
{% if authentik_proxmox_names | length > 0 %}

  # --- Proxmox (OpenID Connect) -----------------------------------------------------------
  # The cluster's realm (role pve_sso) logs in here. The redirect is the gateway name the
  # browser opened: {{ authentik_proxmox_names | join(', ') }}.
  - model: authentik_providers_oauth2.oauth2provider
    id: proxmox-provider
    identifiers:
      name: anvil-proxmox
    attrs:
      client_type: confidential
      # Authentik 2026 allows no grant type unless listed: the login (code) and its renewal.
      grant_types: [authorization_code, refresh_token]
      client_id: {{ authentik_proxmox_client_id | to_json }}
      client_secret: !Env [ANVIL_PROXMOX_CLIENT_SECRET, ""]
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      sub_mode: user_username
      include_claims_in_id_token: true
      redirect_uris:
        - matching_mode: regex
          url: {{ ('^https://(' ~ (authentik_proxmox_names | map('regex_escape') | join('|')) ~ ')\.'
                  ~ (gateway_domain | regex_escape) ~ '(/.*)?$') | to_json }}
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]

  - model: authentik_core.application
    id: proxmox-app
    identifiers:
      slug: {{ authentik_proxmox_client_id | to_json }}
    attrs:
      name: Proxmox
      provider: !KeyOf proxmox-provider
      meta_launch_url: {{ ('https://' ~ authentik_proxmox_names[0] ~ '.' ~ gateway_domain) | to_json }}

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf proxmox-app
      group: !KeyOf sso-group
    attrs:
      order: 0
{% endif %}
