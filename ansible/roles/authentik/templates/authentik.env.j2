# Managed by anvil (ansible/roles/authentik). Secrets from Vault, mode 600. Read by the
# server and the worker. The bootstrap values count only on the first start.
AUTHENTIK_SECRET_KEY={{ authentik_secrets.secret_key }}
AUTHENTIK_POSTGRESQL__PASSWORD={{ authentik_secrets.postgres_password }}
AUTHENTIK_BOOTSTRAP_PASSWORD={{ authentik_secrets.bootstrap_password }}
AUTHENTIK_BOOTSTRAP_TOKEN={{ authentik_secrets.bootstrap_token }}
AUTHENTIK_BOOTSTRAP_EMAIL={{ authentik_bootstrap_email }}
