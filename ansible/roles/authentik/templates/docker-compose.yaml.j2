# Managed by anvil (ansible/roles/authentik); changes here are overwritten on the next run.
# The server and the worker run the same image with the same settings.
x-authentik-environment: &authentik-environment
  AUTHENTIK_POSTGRESQL__HOST: db
  AUTHENTIK_POSTGRESQL__NAME: authentik
  AUTHENTIK_POSTGRESQL__USER: authentik
  AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS: "{{ authentik_trusted_proxies | join(',') }}"
  AUTHENTIK_DISABLE_UPDATE_CHECK: "true"
  AUTHENTIK_DISABLE_STARTUP_ANALYTICS: "true"
  AUTHENTIK_ERROR_REPORTING__ENABLED: "false"

services:
  server:
    image: {{ authentik_image }}
    container_name: authentik-server
    command: server
    depends_on:
      db: {condition: service_healthy}
    env_file: authentik.env
    environment: *authentik-environment
    ports:
      # The gateway reaches it on the lab address. Nothing else is published: no 9443 and no
      # LDAP yet.
      - "{{ authentik_bind_ip }}:{{ authentik_port }}:9000"
    volumes:
      - data:/data
    # Authentik keeps its temporary files in /dev/shm (TMPDIR), as upstream sizes it.
    shm_size: 512mb
    security_opt:
      - no-new-privileges:true
    mem_limit: {{ authentik_server_mem_limit }}
    memswap_limit: {{ authentik_server_mem_limit }}
    restart: unless-stopped

  # No Docker socket and not root (upstream mounts both for outposts it would manage itself).
  # The LDAP outpost will be its own container.
  worker:
    image: {{ authentik_image }}
    container_name: authentik-worker
    command: worker
    depends_on:
      db: {condition: service_healthy}
    env_file: authentik.env
    environment: *authentik-environment
    volumes:
      - data:/data
    shm_size: 512mb
    security_opt:
      - no-new-privileges:true
    mem_limit: {{ authentik_worker_mem_limit }}
    memswap_limit: {{ authentik_worker_mem_limit }}
    restart: unless-stopped

  db:
    image: {{ authentik_postgres_image }}
    container_name: authentik-db
    env_file: db.env
    environment:
      POSTGRES_DB: authentik
      POSTGRES_USER: authentik
    volumes:
      - db:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "authentik", "-d", "authentik"]
      interval: 10s
      timeout: 5s
      retries: 10
    security_opt:
      - no-new-privileges:true
    mem_limit: {{ authentik_postgres_mem_limit }}
    memswap_limit: {{ authentik_postgres_mem_limit }}
    restart: unless-stopped

volumes:
  data:
  db:
