# Managed by Ansible (role authentik). Mode 600. The S3 remote "akb" (Ceph RGW user with
# access to the backup bucket only; keys from Vault).
RCLONE_CONFIG=/dev/null
RCLONE_CONFIG_AKB_TYPE=s3
RCLONE_CONFIG_AKB_PROVIDER=Ceph
RCLONE_CONFIG_AKB_ENV_AUTH=false
RCLONE_CONFIG_AKB_ENDPOINT={{ authentik_backup_endpoint }}
RCLONE_CONFIG_AKB_ACCESS_KEY_ID={{ authentik_backup_keys.s3_access_key }}
RCLONE_CONFIG_AKB_SECRET_ACCESS_KEY={{ authentik_backup_keys.s3_secret_key }}
