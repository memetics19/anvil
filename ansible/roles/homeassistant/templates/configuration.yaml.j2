# Managed by Ansible (role homeassistant). Local-first: data stays in the lab. Devices are added
# through the web UI (config flow) or their own packages. The real "no data leaves" guarantee is
# the iot_egress guard, which blocks this host from the internet.
homeassistant:
  name: Home
  time_zone: {{ homeassistant_timezone }}
  # Code-defined config (automations and more) rebuilt from anvil, under packages/.
  packages: !include_dir_named packages

# Everything default_config brings, so the UI and local discovery work. Nabu Casa cloud is never
# logged in to, and the egress guard blocks any outbound attempt.
default_config:

# Prometheus metrics for the lab's own monitoring. vmagent scrapes /api/prometheus with a
# long-lived token. Local only: the scraper is in the lab, nothing leaves.
prometheus:
  namespace: homeassistant

# Reverse-proxy trust (use_x_forwarded_for + trusted_proxies) is NOT set here: current Home
# Assistant migrated http config to its own storage (a YAML http block is deprecated and fights
# a pending/confirm safety). It is set once in HA (Settings, System, Network) or its
# .storage/http, trusting the lab subnet (the Cloudflare tunnel connectors run on
# several lab hosts). docs/services.md.


automation: !include automations.yaml
script: !include scripts.yaml
scene: !include scenes.yaml
