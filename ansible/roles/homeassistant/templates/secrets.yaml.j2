# Managed by Ansible (role homeassistant). Secrets for code-defined config (packages), kept
# out of the packages themselves and referenced with !secret. The Gotify server runs on the
# frigate VM; the token is the same one frigate-notify uses (Vault kv homelab/frigate/frigate-notify).
gotify_url: "http://{{ site.hosts.frigate.ip }}:8080/message?token={{ homeassistant_gotify_token }}"
