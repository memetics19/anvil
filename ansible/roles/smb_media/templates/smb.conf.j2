# Managed by anvil (ansible/roles/smb_media): read-only media shares, guest access, only the
# listed readers. Changes here are overwritten on the next run.
[global]
   workgroup = WORKGROUP
   server string = anvil media
   security = user
   map to guest = Bad User
   guest account = {{ smb_media_guest_user }}
   server min protocol = SMB2
   # No printers.
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   # Only the readers, by Samba too (the nftables guard is the boundary).
   hosts allow = {{ smb_media_readers | join(' ') }}
   hosts deny = 0.0.0.0/0
   log file = /var/log/samba/log.%m
   max log size = 1000

{% for sh in smb_media_shares %}
[{{ sh.name }}]
   path = {{ sh.path }}
   browseable = yes
   read only = yes
   guest ok = yes
{% endfor %}
