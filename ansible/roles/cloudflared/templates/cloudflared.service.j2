[Unit]
Description=cloudflared
After=network-online.target
Wants=network-online.target

[Service]
TimeoutStartSec=15
Type=notify
ExecStart=/usr/bin/cloudflared --no-autoupdate --metrics {{ cloudflared_metrics }} tunnel run --token-file {{ cloudflared_token_file }}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
