# Managed by Ansible (role caddy) from site.services. Every name is <name>.<domain>, served
# with the one wildcard certificate; plain HTTP redirects to HTTPS.
{
	email {{ caddy_email }}
	servers {
		# No HTTP/3: only TCP is published.
		protocols h1 h2
		timeouts {
			read_header 15s
			idle 5m
		}
	}
}

*.{{ caddy_domain }} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers {{ caddy_dns_resolvers | join(' ') }}
	}
{% for s in caddy_routes %}

{% set allow = caddy_admin_sources if s.name in caddy_admin_only_routes
                else (caddy_infra_sources if s.name in caddy_infra_routes else none) %}
	@{{ s.name }} host {{ s.fqdn }}
	handle @{{ s.name }} {
{% if allow is not none %}
		# The operator's devices only; every other client gets 403, before anything else
		# (a route block keeps this order; Caddy would otherwise run redir before respond).
		@{{ s.name }}_denied not remote_ip {{ allow | join(' ') }}
{% endif %}
{% if allow is not none or s.sso %}
		route {
{% endif %}
{% if allow is not none %}
		respond @{{ s.name }}_denied 403
{% endif %}
{% if s.sso %}
		# Single sign-on: Authentik's outpost answers its own paths and decides on every other
		# request. Without a valid login the browser goes to the sign-in page.
		reverse_proxy /outpost.goauthentik.io/* {{ caddy_sso_upstream }}
		forward_auth {{ caddy_sso_upstream }} {
			uri /outpost.goauthentik.io/auth/caddy
		}
{% endif %}
{% if s.home is defined %}
		redir / {{ s.home }}
{% endif %}
{% if s.static is defined %}
		# Files from the read-only mount (role caddy, tasks/static.yml), no upstream.
		root * /srv/{{ s.static }}
		file_server
{% else %}
		reverse_proxy {{ s.url }} {
{% if s.host_header | default('original') == 'upstream' %}
			header_up Host {upstream_hostport}
{% endif %}
{% if s.rewrite_location | default(false) | bool %}
			# Absolute redirects to the upstream's own address, or to this name over plain
			# HTTP, come back to this name over HTTPS with the same path.
			header_down Location "^https?://({{ s.addr | regex_replace('[.]', '[.]') }}|{{ s.fqdn | regex_replace('[.]', '[.]') }})(:[0-9]+)?(/.*)?$" "https://{{ s.fqdn }}$3"
{% endif %}
{% if s.strip_cookies | default(false) | bool %}
			# Some old embedded web servers echo the request's Cookie header back into the
			# response without a line break, which breaks the reply. Browsers hold cookies
			# for other names under the domain (analytics, for example), so none are sent on.
			header_up -Cookie
{% endif %}
{% if s.stream | default(false) | bool %}
			flush_interval -1
{% endif %}
{% if s.websocket | default(false) | bool %}
			stream_close_delay 5m
{% endif %}
			transport http {
				dial_timeout 5s
{% if not (s.stream | default(false) | bool) %}
				response_header_timeout 5m
{% endif %}
{% if s.insecure_upstream | default(false) | bool %}
				tls_insecure_skip_verify
{% endif %}
{% if s.upstream_ca is defined %}
				tls_trust_pool file /etc/caddy/ca/{{ s.upstream_ca }}.pem
{% endif %}
			}
		}
{% endif %}
{% if allow is not none or s.sso %}
		}
{% endif %}
	}
{% endfor %}

	# Any other name under the domain: close the connection.
	handle {
		abort
	}
}
