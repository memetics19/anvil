# Managed by Ansible (role caddy) from site.services. Every name is <name>.<domain>, served
# with the one wildcard certificate; plain HTTP redirects to HTTPS.
#
# A route with Anubis (role caddy, caddy_anubis_*) has two tiers: the public listener checks the
# operator-only sources (it sees the real client), then hands the request to Anubis, which
# challenges browsers and passes the rest on to Caddy's internal listener with the same Host.
# That listener holds the route itself: single sign-on, redirects and the upstream.
{% macro serve(s) %}
{% if s.sso %}
		# Single sign-on: Authentik's outpost answers its own paths and decides on every other
		# request. Without a valid login the browser goes to the sign-in page.
		reverse_proxy /outpost.goauthentik.io/* {{ caddy_sso_upstream }}
		forward_auth {{ caddy_sso_upstream }} {
			uri /outpost.goauthentik.io/auth/caddy
		}
{% endif %}
{% if s.home is defined %}
		redir / {{ s.home }}
{% endif %}
{% if s.static is defined %}
		# Files from the read-only mount (role caddy, tasks/static.yml), no upstream.
		root * /srv/{{ s.static }}
		file_server
{% else %}
		reverse_proxy {{ s.url }} {
{% if s.host_header | default('original') == 'upstream' %}
			header_up Host {upstream_hostport}
{% endif %}
{% if s.rewrite_location | default(false) | bool %}
			# Absolute redirects to the upstream's own address, or to this name over plain
			# HTTP, come back to this name over HTTPS with the same path.
			header_down Location "^https?://({{ s.addr | regex_replace('[.]', '[.]') }}|{{ s.fqdn | regex_replace('[.]', '[.]') }})(:[0-9]+)?(/.*)?$" "https://{{ s.fqdn }}$3"
{% endif %}
{% if s.strip_cookies | default(false) | bool %}
			# Some old embedded web servers echo the request's Cookie header back into the
			# response without a line break, which breaks the reply. Browsers hold cookies
			# for other names under the domain (analytics, for example), so none are sent on.
			header_up -Cookie
{% endif %}
{% if s.stream | default(false) | bool %}
			flush_interval -1
{% endif %}
{% if s.websocket | default(false) | bool %}
			stream_close_delay 5m
{% endif %}
			transport http {
				dial_timeout 5s
{% if not (s.stream | default(false) | bool) %}
				response_header_timeout 5m
{% endif %}
{% if s.insecure_upstream | default(false) | bool %}
				tls_insecure_skip_verify
{% endif %}
{% if s.upstream_ca is defined %}
				tls_trust_pool file /etc/caddy/ca/{{ s.upstream_ca }}.pem
{% endif %}
			}
		}
{% endif %}
{%- endmacro %}
{
	email {{ caddy_email }}
	servers {
		# No HTTP/3: only TCP is published.
		protocols h1 h2
		timeouts {
			read_header 15s
			idle 5m
		}
	}
{% if caddy_anubis_routes | length > 0 %}
	servers :{{ caddy_anubis_backend_port }} {
		# Only Anubis reaches this listener (its network, never published). Keep the client
		# address and the https scheme the public listener set, so the apps and single sign-on
		# see the request as it came in.
		trusted_proxies static private_ranges
		protocols h1
	}
{% endif %}
}

*.{{ caddy_domain }} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers {{ caddy_dns_resolvers | join(' ') }}
	}
{% for s in caddy_routes %}

{% set allow = caddy_admin_sources if s.name in caddy_admin_only_routes
                else (caddy_infra_sources if s.name in caddy_infra_routes else none) %}
{% set anubis = s.anubis | default(false) %}
	@{{ s.name }} host {{ s.fqdn }}
	handle @{{ s.name }} {
{% if allow is not none %}
		# The operator's devices only; every other client gets 403, before anything else
		# (a route block keeps this order; Caddy would otherwise run redir before respond).
		@{{ s.name }}_denied not remote_ip {{ allow | join(' ') }}
{% endif %}
{% if allow is not none or (s.sso and not anubis) %}
		route {
{% endif %}
{% if allow is not none %}
		respond @{{ s.name }}_denied 403
{% endif %}
{% if anubis %}
		# Anubis first: browsers solve a proof-of-work check, apps and scripts pass. It hands
		# the request to this name's route on the internal listener.
		reverse_proxy {{ caddy_anubis_upstream }} {
			header_up X-Real-IP {remote_host}
{% if s.stream | default(false) | bool %}
			flush_interval -1
{% endif %}
{% if s.websocket | default(false) | bool %}
			stream_close_delay 5m
{% endif %}
			transport http {
				dial_timeout 5s
{% if not (s.stream | default(false) | bool) %}
				response_header_timeout 5m
{% endif %}
			}
		}
{% else %}
{{ serve(s) }}{% endif %}
{% if allow is not none or (s.sso and not anubis) %}
		}
{% endif %}
	}
{% endfor %}

	# Any other name under the domain: close the connection.
	handle {
		abort
	}
}
{% if caddy_anubis_routes | length > 0 %}

# The routes behind Anubis, as it hands them on (same Host, plain HTTP inside the VM).
http://:{{ caddy_anubis_backend_port }} {
{% for s in caddy_anubis_routes %}

	@{{ s.name }} host {{ s.fqdn }}
	handle @{{ s.name }} {
{% if s.sso %}
		route {
{% endif %}
{{ serve(s) }}{% if s.sso %}
		}
{% endif %}
	}
{% endfor %}

	handle {
		abort
	}
}
{% endif %}
