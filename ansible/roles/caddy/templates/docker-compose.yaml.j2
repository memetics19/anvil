# Managed by Ansible (role caddy). The service gateway: published on the VM's lab and home
# addresses only (never 0.0.0.0; ufw does not filter Docker-published ports).
services:
  caddy:
    image: {{ caddy_image }}
    container_name: caddy
    restart: unless-stopped
    ports:
{% for ip in caddy_listen_ips %}
      - "{{ ip }}:80:80/tcp"
      - "{{ ip }}:443:443/tcp"
{% endfor %}
    environment:
      GOMEMLIMIT: {{ caddy_gomemlimit | to_json }}
      GODEBUG: {{ caddy_godebug | to_json }}
    # CLOUDFLARE_API_TOKEN (from Vault).
    env_file: caddy.env
    volumes:
      # The directory, not the file: Ansible replaces the Caddyfile by rename, which a
      # file bind mount would not see.
      - ./etc:/etc/caddy:ro
      # Static sites (tasks/static.yml), read-only.
      - ./sites:/srv:ro
      - ./data:/data
      - ./config:/config
    networks:
      # Caddy's own network carries its default route (its connections to upstreams leave
      # through it; the enclave guard admits only this network's subnet).
      gateway:
        gw_priority: 100
{% for n in caddy_networks_joined | default(caddy_container_networks | list) %}
      {{ n }}: {}
{% endfor %}
{% if caddy_anubis_routes | length > 0 %}
      anubis: {}
{% endif %}
    mem_limit: {{ caddy_mem_limit }}
    memswap_limit: {{ caddy_mem_limit }}
{% if caddy_anubis_routes | length > 0 %}

  # Anubis (defaults/main.yml, caddy_anubis_*): only on its own network, never on Caddy's
  # gateway network (the one the secrets enclave admits). It reaches Caddy's internal listener
  # and nothing else: the network has no route out.
  anubis:
    image: {{ caddy_anubis_image }}
    container_name: anubis
    restart: unless-stopped
    environment:
      BIND: ":8923"
      TARGET: "http://caddy:{{ caddy_anubis_backend_port }}"
      # One pass for every name under the domain.
      COOKIE_DOMAIN: {{ caddy_domain | to_json }}
      SERVE_ROBOTS_TXT: "true"
    # The signing key (Vault), so a pass survives a restart. Not required: a dry run on a new
    # VM has not written it yet.
    env_file:
      - path: anubis.env
        required: false
    read_only: true
    tmpfs: [/tmp]
    security_opt: [no-new-privileges:true]
    networks:
      anubis: {}
    mem_limit: {{ caddy_anubis_mem_limit }}
    memswap_limit: {{ caddy_anubis_mem_limit }}
{% endif %}

networks:
{% if caddy_gateway_subnet | length > 0 %}
  # Pinned (tasks/gateway_net.yml): the enclave guard matches this bridge and subnet.
  gateway:
    driver_opts:
      com.docker.network.bridge.name: {{ caddy_gateway_bridge }}
    ipam:
      config:
        - subnet: {{ caddy_gateway_subnet }}
{% else %}
  gateway: {}
{% endif %}
{% for n in caddy_networks_joined | default(caddy_container_networks | list) %}
  {{ n }}:
    external: true
{% endfor %}
{% if caddy_anubis_routes | length > 0 %}
  anubis:
    internal: true
{% endif %}
