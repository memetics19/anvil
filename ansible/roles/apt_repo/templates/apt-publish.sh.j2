#!/bin/bash
# Managed by Ansible (role apt_repo). Keeps the signed apt repository current, pulling from
# GitHub. Run by apt-publish.timer and once by the role.
#   1. Every vX.Y.Z tag of REPO gets its <package>_<version>_<arch>.deb files from the
#      release, checked against the release's checksums.txt, into pool/ (kept, never
#      fetched again). A release without .deb files is noted and skipped from then on.
#   2. When pool/ or the signing key changed, a new tree is built next to the live one:
#      Packages for each architecture, Release, InRelease and Release.gpg signed with KEY,
#      and the public key as <package>.asc. The signature is checked with gpgv against that
#      public key, then the site/current link moves to the new tree in one rename.
# Usage: apt-publish [--check]   (--check prints what it would do and changes nothing)
# Settings come from CONF (publish.conf, written by the role).
set -euo pipefail

conf=${APT_PUBLISH_CONF:-{{ apt_repo_dir }}/publish.conf}
{% raw %}
# shellcheck source=/dev/null
. "$conf"
check=false
[ "${1:-}" = --check ] && check=true

log() { echo "apt-publish: $*"; }
die() { echo "apt-publish: $*" >&2; exit 1; }
trap 'echo "apt-publish: failed at line $LINENO" >&2' ERR

pool="$DIR/pool/$COMPONENT/${PACKAGE:0:1}/$PACKAGE"
mkdir -p "$pool" "$DIR/state" "$DIR/site"
exec 9>"$DIR/state/lock"
flock -n 9 || die "another apt-publish is running"

tags=$(git ls-remote --tags --refs "$REPO_URL" 'v*' | awk '{sub("refs/tags/", "", $2); print $2}' |
  grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V) || true
[ -n "$tags" ] || die "no vX.Y.Z tag in $REPO_URL"

# --- 1. fetch what is missing ----------------------------------------------------------------
missing=()
for tag in $tags; do
  [ -e "$DIR/state/no-deb-$tag" ] && continue
  for arch in $ARCHES; do
    [ -f "$pool/${PACKAGE}_${tag#v}_$arch.deb" ] || missing+=("$tag/$arch")
  done
done

key_now=$(gpg --homedir "$GNUPGHOME" --batch --with-colons --list-secret-keys 2>/dev/null |
  awk -F: '$1 == "fpr" {print $10; exit}')
[ -n "$key_now" ] || die "no signing key in $GNUPGHOME"
key_built=$(cat "$DIR/state/key" 2>/dev/null || true)

if $check; then
  if [ ${#missing[@]} -gt 0 ]; then log "would fetch ${missing[*]}"; else log "pool: up to date"; fi
  if [ ! -e "$DIR/site/current" ] || [ "$key_now" != "$key_built" ]; then log "would rebuild and sign the index"; fi
  exit 0
fi

work=$(mktemp -d "$DIR/state/fetch.XXXXXX")
trap 'rm -rf "$work"' EXIT
fetched=0
for item in "${missing[@]}"; do
  tag=${item%/*} arch=${item#*/}
  deb="${PACKAGE}_${tag#v}_$arch.deb"
  base="$RELEASES/download/$tag"
  if [ ! -f "$work/$tag.sums" ] && ! curl -fsSL -o "$work/$tag.sums" "$base/checksums.txt"; then
    log "$tag has no checksums.txt, skipped from now on"
    touch "$DIR/state/no-deb-$tag"
    continue
  fi
  if ! grep -qE "  $deb\$" "$work/$tag.sums"; then
    log "$tag has no $deb, skipped from now on"
    touch "$DIR/state/no-deb-$tag"
    continue
  fi
  curl -fsSL -o "$work/$deb" "$base/$deb" || die "cannot download $deb"
  (cd "$work" && grep -E "  $deb\$" "$tag.sums" | sha256sum -c --status) || die "checksum mismatch for $deb"
  mv "$work/$deb" "$pool/$deb"
  fetched=$((fetched + 1))
  log "added $deb"
done

if [ "$fetched" -eq 0 ] && [ -e "$DIR/site/current" ] && [ "$key_now" = "$key_built" ]; then
  exit 0
fi

# --- 2. build, sign, check and swap in ---------------------------------------------------------
# A fresh directory per build, even for two builds in the same second.
tree=$(mktemp -d "$DIR/site/$(date -u +%Y%m%d-%H%M%S).XXXXXX")
chmod 755 "$tree"
stamp=$(basename "$tree")
cp -al "$DIR/pool" "$tree/pool"
dist="$tree/dists/$SUITE"
for arch in $ARCHES; do
  mkdir -p "$dist/$COMPONENT/binary-$arch"
  (cd "$tree" && apt-ftparchive --arch "$arch" packages "pool/$COMPONENT") >"$dist/$COMPONENT/binary-$arch/Packages"
  gzip -9nk "$dist/$COMPONENT/binary-$arch/Packages"
done
apt-ftparchive \
  -o "APT::FTPArchive::Release::Origin=$PACKAGE" -o "APT::FTPArchive::Release::Label=$PACKAGE" \
  -o "APT::FTPArchive::Release::Suite=$SUITE" -o "APT::FTPArchive::Release::Codename=$SUITE" \
  -o "APT::FTPArchive::Release::Architectures=$ARCHES" \
  -o "APT::FTPArchive::Release::Components=$COMPONENT" \
  release "$dist" >"$tree/Release.tmp"
mv "$tree/Release.tmp" "$dist/Release"
gpg --homedir "$GNUPGHOME" --batch --yes --local-user "$key_now" --clearsign -o "$dist/InRelease" "$dist/Release"
gpg --homedir "$GNUPGHOME" --batch --yes --local-user "$key_now" --armor --detach-sign -o "$dist/Release.gpg" "$dist/Release"
gpg --homedir "$GNUPGHOME" --batch --armor --export "$key_now" >"$tree/$PACKAGE.asc"
gpg --homedir "$GNUPGHOME" --batch --export "$key_now" >"$tree/$PACKAGE.gpg"
[ ! -f "$DIR/index.html" ] || cp "$DIR/index.html" "$tree/index.html"

# What a client sees: the published key must verify both signatures.
gpgv --keyring "$tree/$PACKAGE.gpg" "$dist/InRelease" 2>/dev/null || die "InRelease does not verify with $PACKAGE.gpg"
gpgv --keyring "$tree/$PACKAGE.gpg" "$dist/Release.gpg" "$dist/Release" 2>/dev/null ||
  die "Release.gpg does not verify with $PACKAGE.gpg"

old=$(readlink "$DIR/site/current" 2>/dev/null || true)
ln -sfn "$stamp" "$DIR/site/current.new" && mv -T "$DIR/site/current.new" "$DIR/site/current"
echo "$key_now" >"$DIR/state/key"
log "published $(find "$DIR/pool" -name '*.deb' | wc -l | tr -d ' ') packages, signed by ${key_now: -16}"
# Keep the previous tree for a client that is halfway through an update.
find "$DIR/site" -mindepth 1 -maxdepth 1 -type d ! -name "$stamp" ! -name "${old:-none}" -exec rm -r -- {} +
{% endraw %}
